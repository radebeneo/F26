# ============================================================
# FIFA World Cup 2026 Fantasy – Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ============================================================

# ----- Public site URL (used in email confirmation redirect links) -----
# Local dev:  http://localhost:3000
# Production: https://your-vercel-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----- Supabase (public – safe to expose to the browser) -----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ----- Supabase (server-only – NEVER expose client-side) -----
SUPABASE_SERVICE_ROLE_KEY=

# ----- Drizzle ORM connection string -----
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]?sslmode=require
# Find this in: Supabase → Settings → Database → Connection string → URI (Transaction mode port 6543)
DATABASE_URL=

# ----- Admin API secret -----
# Bearer token for POST /api/admin/stats
# Generate with: openssl rand -hex 32
ADMIN_API_SECRET=

# ----- Resend (custom SMTP for Supabase Auth emails) -----
# 1. Create an account at https://resend.com
# 2. Generate an API key (Resend dashboard → API Keys)
# 3. In Supabase: Project Settings → Auth → SMTP Settings
#    Host: smtp.resend.com  Port: 465  Username: resend  Password: <your key>
# 4. Enable email confirmation in Supabase Auth settings.
# Note: RESEND_API_KEY is only used for Supabase SMTP config, not in code.
RESEND_API_KEY=
